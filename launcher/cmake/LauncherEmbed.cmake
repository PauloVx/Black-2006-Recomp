# black_embed(<output.cpp> <namespace> <function>=<file> ...)
# Writes a source file that returns each file's bytes from a function:
#     std::span<const unsigned char> <namespace>::<function>();
# so the launcher is one executable with its fonts inside. Re-runs when an embedded file changes.
function(black_embed output namespace)
    set(body "")
    foreach(pair IN LISTS ARGN)
        string(REPLACE "=" ";" parts "${pair}")
        list(GET parts 0 function)
        list(GET parts 1 file)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        file(READ "${file}" hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
        get_filename_component(name "${file}" NAME)
        string(APPEND body
            "namespace {\nconstexpr unsigned char k_${function}[] = {\n${bytes}};\n}  // namespace\n"
            "// ${name}\nstd::span<const unsigned char> ${function}() { return k_${function}; }\n\n")
    endforeach()
    file(CONFIGURE OUTPUT "${output}" CONTENT
"// Generated by launcher/cmake/LauncherEmbed.cmake. Do not edit.
#include <span>

namespace ${namespace} {

@body@}  // namespace ${namespace}
" @ONLY)
endfunction()
